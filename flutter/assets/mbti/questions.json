  "version": 1,
  "scale": {
    "min": 1,
    "max": 7,
    "labels": ["很不同意", "比较不同意", "有点不同意", "中立", "有点同意", "比较同意", "很同意"]
  },
  "dimensions": {
    "EI": { "left": "E", "right": "I", "leftName": "外向", "rightName": "内向" },
    "SN": { "left": "S", "right": "N", "leftName": "实感", "rightName": "直觉" },
    "TF": { "left": "T", "right": "F", "leftName": "思考", "rightName": "情感" },
    "JP": { "left": "J", "right": "P", "leftName": "判断", "rightName": "知觉" },
    "AT": { "left": "A", "right": "T", "leftName": "稳定", "rightName": "敏感" }
  },
  "questions": [
    { "id": "EI-01", "dim": "EI", "facet": "social", "text": "参加完一场热闹的聚会，我通常觉得意犹未尽，还想再玩一会儿。", "keyed": "left", "std": true, "quick": true },
    { "id": "EI-02", "dim": "EI", "facet": "expression", "text": "和不熟悉的人聊天时，我通常会先在心里过一遍要说的话，再开口。", "keyed": "right", "std": true, "quick": true },
    { "id": "EI-03", "dim": "EI", "facet": "solitude", "text": "周末没有任何社交安排，我多半会觉得松了一口气，而不是失落。", "keyed": "right", "std": true, "quick": false },
    { "id": "EI-04", "dim": "EI", "facet": "expression", "text": "讨论问题时，我习惯一边说一边整理思路，说着说着想法就清楚了。", "keyed": "left", "std": true, "quick": false, "pair": "EI-14" },
    { "id": "EI-05", "dim": "EI", "facet": "social", "text": "在饭局或群聊里，我通常是主动开启话题的那个人。", "keyed": "left", "std": true, "quick": true },
    { "id": "EI-06", "dim": "EI", "facet": "solitude", "text": "连续几天高强度社交后，我需要一段完全独处的时间才能缓过来。", "keyed": "right", "std": true, "quick": false },
    { "id": "EI-07", "dim": "EI", "facet": "social", "text": "遇到感兴趣的人，我会很自然地上前搭话，不太会觉得尴尬。", "keyed": "left", "std": true, "quick": true },
    { "id": "EI-08", "dim": "EI", "facet": "expression", "text": "能发文字解决的事，我尽量不发语音、不打电话。", "keyed": "right", "std": true, "quick": false },
    { "id": "EI-09", "dim": "EI", "facet": "social", "text": "人越多的场合，我反而越兴奋，状态越好。", "keyed": "left", "std": true, "quick": false },
    { "id": "EI-10", "dim": "EI", "facet": "solitude", "text": "忙碌一周后，对我来说最好的恢复方式是独自待着，做自己的事。", "keyed": "right", "std": true, "quick": true },
    { "id": "EI-11", "dim": "EI", "facet": "expression", "text": "在小组讨论里，我往往先听别人说，轮到自己时才简短讲几句。", "keyed": "right", "std": true, "quick": false },
    { "id": "EI-12", "dim": "EI", "facet": "social", "text": "朋友组局时，我通常是那个帮忙叫人、活跃气氛的角色。", "keyed": "left", "std": true, "quick": false },
    { "id": "EI-13", "dim": "EI", "facet": "solitude", "text": "一个人吃饭、一个人看电影，对我来说是很自在的事。", "keyed": "right", "std": true, "quick": true },
    { "id": "EI-14", "dim": "EI", "facet": "expression", "text": "我更多是把想法在心里想清楚之后，才会拿出来和别人讨论。", "keyed": "right", "std": true, "quick": false, "pair": "EI-04" },
    { "id": "EI-15", "dim": "EI", "facet": "social", "text": "在陌生的聚会上，我大多只和认识的人聊天，很少主动认识新朋友。", "keyed": "right", "std": true, "quick": false },
    { "id": "EI-16", "dim": "EI", "facet": "expression", "text": "聊天时，我说话的数量通常比听别人说的多。", "keyed": "left", "std": true, "quick": true },
    { "id": "EI-17", "dim": "EI", "facet": "solitude", "text": "如果一份工作大部分时间需要独自完成，我会觉得比频繁开会协作更舒服。", "keyed": "right", "std": false, "quick": false },
    { "id": "EI-18", "dim": "EI", "facet": "solitude", "text": "闲着没事时，我会主动找人聊天或约人出门，而不是自己待着。", "keyed": "left", "std": false, "quick": false },
    { "id": "EI-19", "dim": "EI", "facet": "social", "text": "在班级或团队里，大家对我的印象通常是安静、话不多。", "keyed": "right", "std": false, "quick": false },
    { "id": "EI-20", "dim": "EI", "facet": "expression", "text": "情绪上来时，我会马上找人倾诉，而不是自己先消化。", "keyed": "left", "std": false, "quick": false },

    { "id": "SN-01", "dim": "SN", "facet": "possibility", "text": "聊天时，我更喜欢聊“接下来可以怎么玩、怎么变”，而不是复盘已经发生的细节。", "keyed": "right", "std": true, "quick": true },
    { "id": "SN-02", "dim": "SN", "facet": "facts", "text": "读说明书或教程时，我习惯照着步骤一步步来，而不是先自己琢磨原理。", "keyed": "left", "std": true, "quick": true },
    { "id": "SN-03", "dim": "SN", "facet": "possibility", "text": "听到一个新概念，我会不自觉地联想它还能套用到哪些别的事情上。", "keyed": "right", "std": true, "quick": true },
    { "id": "SN-04", "dim": "SN", "facet": "facts", "text": "回忆一次旅行，我脑子里最先浮现的是具体的画面、味道和场景细节。", "keyed": "left", "std": true, "quick": false },
    { "id": "SN-05", "dim": "SN", "facet": "possibility", "text": "比起“这个方法以前管用”，“这个方法有没有新玩法”更能引起我的兴趣。", "keyed": "right", "std": true, "quick": false },
    { "id": "SN-06", "dim": "SN", "facet": "abstract", "text": "看小说或电影时，我喜欢琢磨结局背后的寓意，经常有自己的一套解读。", "keyed": "right", "std": true, "quick": true },
    { "id": "SN-07", "dim": "SN", "facet": "abstract", "text": "纯理论、不解决实际问题的讨论，我通常听一会儿就会觉得无聊。", "keyed": "left", "std": true, "quick": false },
    { "id": "SN-08", "dim": "SN", "facet": "facts", "text": "描述一件事时，我倾向于讲清楚“发生了什么”，而不是“这意味着什么”。", "keyed": "left", "std": true, "quick": false },
    { "id": "SN-09", "dim": "SN", "facet": "possibility", "text": "我经常会突然看到一个点子的可能性，虽然一时说不清具体依据。", "keyed": "right", "std": true, "quick": true },
    { "id": "SN-10", "dim": "SN", "facet": "facts", "text": "学新东西时，我更喜欢从实际例子和动手操作开始，而不是先看理论框架。", "keyed": "left", "std": true, "quick": false },
    { "id": "SN-11", "dim": "SN", "facet": "abstract", "text": "闲暇时，我会主动去想一些比较抽象的问题，比如某个现象背后的规律。", "keyed": "right", "std": true, "quick": false },
    { "id": "SN-12", "dim": "SN", "facet": "facts", "text": "比起畅想未来，我更关注眼前具体要做好的事。", "keyed": "left", "std": true, "quick": false },
    { "id": "SN-13", "dim": "SN", "facet": "facts", "text": "别人介绍经验时，我更想知道“具体怎么做的”，而不是“为什么这么想”。", "keyed": "left", "std": true, "quick": true },
    { "id": "SN-14", "dim": "SN", "facet": "abstract", "text": "我喜欢用比喻来理解或解释事情。", "keyed": "right", "std": true, "quick": false, "pair": "SN-18" },
    { "id": "SN-15", "dim": "SN", "facet": "possibility", "text": "对已经验证有效的做法，我倾向于继续沿用，而不是为了尝试新方式而改动。", "keyed": "left", "std": true, "quick": false },
    { "id": "SN-16", "dim": "SN", "facet": "possibility", "text": "我脑子里经常同时展开好几条“如果……会怎样”的设想。", "keyed": "right", "std": true, "quick": true },
    { "id": "SN-17", "dim": "SN", "facet": "facts", "text": "讲话时我常从细节讲起，把整个经过按顺序说清楚。", "keyed": "left", "std": false, "quick": false },
    { "id": "SN-18", "dim": "SN", "facet": "abstract", "text": "别人觉得我“想太多”，因为我总在琢磨事情背后的含义。", "keyed": "right", "std": false, "quick": false, "pair": "SN-14" },
    { "id": "SN-19", "dim": "SN", "facet": "facts", "text": "我相信亲身经历过的事实，胜过看起来再漂亮的理论。", "keyed": "left", "std": false, "quick": false },
    { "id": "SN-20", "dim": "SN", "facet": "possibility", "text": "一个想法越新奇、越没人试过，我越想听听看。", "keyed": "right", "std": false, "quick": false },

    { "id": "TF-01", "dim": "TF", "facet": "empathy", "text": "朋友向我倾诉烦恼时，我的第一反应是先安抚情绪，而不是帮他分析解决办法。", "keyed": "right", "std": true, "quick": true },
    { "id": "TF-02", "dim": "TF", "facet": "logic", "text": "评价一个方案时，我首先看它在逻辑上站不站得住，而不是大家能不能接受。", "keyed": "left", "std": true, "quick": false },
    { "id": "TF-03", "dim": "TF", "facet": "conflict", "text": "指出别人的问题时，我会先斟酌怎么说，尽量不让对方难堪。", "keyed": "right", "std": true, "quick": true },
    { "id": "TF-04", "dim": "TF", "facet": "conflict", "text": "争论时，就算知道会让气氛变僵，我也会把认为不对的地方直接说出来。", "keyed": "left", "std": true, "quick": false },
    { "id": "TF-05", "dim": "TF", "facet": "empathy", "text": "看到别人哭，我自己的情绪也很容易被带起来。", "keyed": "right", "std": true, "quick": true },
    { "id": "TF-06", "dim": "TF", "facet": "logic", "text": "做决定时，“哪个选择更合理”通常比“哪个选择让我更舒服”更占上风。", "keyed": "left", "std": true, "quick": true },
    { "id": "TF-07", "dim": "TF", "facet": "empathy", "text": "团队里有人情绪低落，我通常会第一时间注意到。", "keyed": "right", "std": true, "quick": false },
    { "id": "TF-08", "dim": "TF", "facet": "conflict", "text": "别人说我有时候说话太直、不近人情，我觉得这种评价不算冤枉。", "keyed": "left", "std": true, "quick": false },
    { "id": "TF-09", "dim": "TF", "facet": "empathy", "text": "帮助别人达成目标的成就感，对我来说比自己把事情做成更强。", "keyed": "right", "std": true, "quick": true },
    { "id": "TF-10", "dim": "TF", "facet": "logic", "text": "我很难理解“明知不划算还要坚持”的决定，除非对方给我讲清楚理由。", "keyed": "left", "std": true, "quick": false },
    { "id": "TF-11", "dim": "TF", "facet": "empathy", "text": "看电影或剧时，我很容易被角色的遭遇打动，代入感很强。", "keyed": "right", "std": true, "quick": false },
    { "id": "TF-12", "dim": "TF", "facet": "conflict", "text": "朋友吵架找我评理，我更在意谁的观点有道理，而不是先照顾两边的情绪。", "keyed": "left", "std": true, "quick": false },
    { "id": "TF-13", "dim": "TF", "facet": "conflict", "text": "拒绝别人时，我常会因为担心对方失望而犹豫。", "keyed": "right", "std": true, "quick": true },
    { "id": "TF-14", "dim": "TF", "facet": "logic", "text": "与其说我想被喜欢，不如说我更想被认可“靠谱、有能力”。", "keyed": "left", "std": true, "quick": false },
    { "id": "TF-15", "dim": "TF", "facet": "empathy", "text": "即使不认同对方的观点，我也很容易理解他为什么会这么想、这么感受。", "keyed": "right", "std": true, "quick": false, "pair": "TF-20" },
    { "id": "TF-16", "dim": "TF", "facet": "logic", "text": "别人向我抱怨时，我常常会不自觉地开始给建议，而不是单纯陪着听。", "keyed": "left", "std": true, "quick": true },
    { "id": "TF-17", "dim": "TF", "facet": "conflict", "text": "规则如果明显不合情理，我会倾向于照顾具体人的处境，而不是一刀切执行。", "keyed": "right", "std": false, "quick": false },
    { "id": "TF-18", "dim": "TF", "facet": "conflict", "text": "我很少因为顾及气氛而放弃表达自己的不同意见。", "keyed": "left", "std": false, "quick": false },
    { "id": "TF-19", "dim": "TF", "facet": "logic", "text": "亲近的人说我有时太理性，情绪不太外露。", "keyed": "left", "std": false, "quick": false },
    { "id": "TF-20", "dim": "TF", "facet": "empathy", "text": "做重要决定时，我会认真考虑它会给相关的人带来什么感受。", "keyed": "right", "std": false, "quick": false, "pair": "TF-15" },

    { "id": "JP-01", "dim": "JP", "facet": "planning", "text": "出门旅行前，我通常会做好攻略，把每天的安排大致定下来。", "keyed": "left", "std": true, "quick": true },
    { "id": "JP-02", "dim": "JP", "facet": "flexibility", "text": "计划临时被打乱时，我多半觉得无所谓，随时可以换一套安排。", "keyed": "right", "std": true, "quick": true },
    { "id": "JP-03", "dim": "JP", "facet": "deadline", "text": "作业或工作有截止日期时，我往往拖到临近截止才集中完成。", "keyed": "right", "std": true, "quick": true },
    { "id": "JP-04", "dim": "JP", "facet": "planning", "text": "我习惯用清单、日程或提醒事项来管理每天要做的事。", "keyed": "left", "std": true, "quick": false },
    { "id": "JP-05", "dim": "JP", "facet": "planning", "text": "比起“到时再说”，提前把事情定下来会让我更安心。", "keyed": "left", "std": true, "quick": false },
    { "id": "JP-06", "dim": "JP", "facet": "order", "text": "我的桌面或房间通常是“看着乱，但我自己知道东西在哪”。", "keyed": "right", "std": true, "quick": true },
    { "id": "JP-07", "dim": "JP", "facet": "planning", "text": "开始新任务前，我喜欢先把步骤和时间安排好，再动手。", "keyed": "left", "std": true, "quick": false },
    { "id": "JP-08", "dim": "JP", "facet": "flexibility", "text": "我经常同时开着好几件事，哪件有灵感就先做哪件。", "keyed": "right", "std": true, "quick": false },
    { "id": "JP-09", "dim": "JP", "facet": "flexibility", "text": "决定一件事后，我不太喜欢反复改主意，定了就按这个来。", "keyed": "left", "std": true, "quick": true, "pair": "JP-14" },
    { "id": "JP-10", "dim": "JP", "facet": "flexibility", "text": "自由安排的一天里，我通常不会提前规划，睡到自然醒再看心情。", "keyed": "right", "std": true, "quick": false },
    { "id": "JP-11", "dim": "JP", "facet": "deadline", "text": "我会先把该做的事做完，再安心休息或娱乐。", "keyed": "left", "std": true, "quick": false },
    { "id": "JP-12", "dim": "JP", "facet": "flexibility", "text": "临时起意的安排（比如朋友突然约出门）对我来说不是负担，反而挺有趣。", "keyed": "right", "std": true, "quick": false },
    { "id": "JP-13", "dim": "JP", "facet": "order", "text": "买东西前，我通常会提前列好清单，按计划采购。", "keyed": "left", "std": true, "quick": true },
    { "id": "JP-14", "dim": "JP", "facet": "flexibility", "text": "我更喜欢保留选择的余地，不喜欢太早把事情定死。", "keyed": "right", "std": true, "quick": false, "pair": "JP-09" },
    { "id": "JP-15", "dim": "JP", "facet": "order", "text": "东西用完放回原位、物品各归其位，是我的日常习惯。", "keyed": "left", "std": true, "quick": false },
    { "id": "JP-16", "dim": "JP", "facet": "deadline", "text": "我做事的节奏更像是“死线前爆发”，而不是每天均匀推进。", "keyed": "right", "std": true, "quick": true },
    { "id": "JP-17", "dim": "JP", "facet": "deadline", "text": "约会或赶车时，我通常会预留缓冲时间，宁可早到。", "keyed": "left", "std": false, "quick": false },
    { "id": "JP-18", "dim": "JP", "facet": "flexibility", "text": "比起按部就班，我更喜欢随机应变地解决问题。", "keyed": "right", "std": false, "quick": false },
    { "id": "JP-19", "dim": "JP", "facet": "deadline", "text": "未完成的待办事项会一直挂在我心上，让我难以彻底放松。", "keyed": "left", "std": false, "quick": false },
    { "id": "JP-20", "dim": "JP", "facet": "planning", "text": "攻略做得太细的旅行，反而让我觉得少了点意思。", "keyed": "right", "std": false, "quick": false },

    { "id": "AT-01", "dim": "AT", "facet": "calm", "text": "即使压力很大，我通常也能保持镇定，按节奏把事情处理完。", "keyed": "left", "std": false, "quick": false },
    { "id": "AT-02", "dim": "AT", "facet": "doubt", "text": "一个小失误，就足以让我怀疑自己整件事的能力。", "keyed": "right", "std": false, "quick": false },
    { "id": "AT-03", "dim": "AT", "facet": "doubt", "text": "我很少担心别人对我的第一印象好不好。", "keyed": "left", "std": false, "quick": false },
    { "id": "AT-04", "dim": "AT", "facet": "worry", "text": "事情还没出结果前，我总会忍不住往最坏的方向想。", "keyed": "right", "std": false, "quick": false },
    { "id": "AT-05", "dim": "AT", "facet": "mood", "text": "我的情绪起伏比较明显，可能短时间内就从开心变得低落。", "keyed": "right", "std": false, "quick": false },
    { "id": "AT-06", "dim": "AT", "facet": "worry", "text": "很久前犯的错，我到现在想起来还会耿耿于怀。", "keyed": "right", "std": false, "quick": false },
    { "id": "AT-07", "dim": "AT", "facet": "doubt", "text": "我很少反复回想自己做过的决定是否正确。", "keyed": "left", "std": false, "quick": false },
    { "id": "AT-08", "dim": "AT", "facet": "mood", "text": "被别人批评后，我需要比较长的时间才能平复。", "keyed": "right", "std": false, "quick": false },
    { "id": "AT-09", "dim": "AT", "facet": "calm", "text": "大多数时候，我对自己的现状是满意的，不太焦虑。", "keyed": "left", "std": false, "quick": false },
    { "id": "AT-10", "dim": "AT", "facet": "worry", "text": "别人一句无心的话，我可能会琢磨很久。", "keyed": "right", "std": false, "quick": false },
    { "id": "AT-11", "dim": "AT", "facet": "calm", "text": "遇到突发状况时，我通常先慌乱，过一会儿才能冷静下来。", "keyed": "right", "std": false, "quick": false },
    { "id": "AT-12", "dim": "AT", "facet": "calm", "text": "即便遇到挫折，我也能比较快恢复信心，继续往前。", "keyed": "left", "std": false, "quick": false },
    { "id": "AT-13", "dim": "AT", "facet": "doubt", "text": "我经常担心自己做得不够好，配不上别人的期待。", "keyed": "right", "std": false, "quick": false },
    { "id": "AT-14", "dim": "AT", "facet": "mood", "text": "我的情绪不太受周围环境影响，比较稳。", "keyed": "left", "std": false, "quick": false },
