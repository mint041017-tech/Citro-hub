/* 首页：奶油纸张 + 纯 CSS 时段光晕 + 固定顺序卡片。
   背景不再使用 4 张 1024×1024 webp，改为可随时段变化的轻渐变，
   卡片质感与 App 对齐（48rpx 圆角、中性阴影、无描边）。 */

/* ---------------- 1. 自定义顶栏 ---------------- */

.topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 40;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.topbar-dawn,
.topbar-day,
.topbar-dusk {
  background: linear-gradient(
    180deg,
    rgba(249, 237, 215, 0.86) 0%,
    rgba(249, 237, 215, 0) 100%
  );
}

.topbar-night {
  background: linear-gradient(
    180deg,
    rgba(30, 26, 24, 0.5) 0%,
    rgba(30, 26, 24, 0) 100%
  );
}

.topbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 2rpx;
  color: var(--ink);
}

.topbar-night .brand {
  color: #fff8ec;
  text-shadow: 0 2rpx 12rpx rgba(30, 20, 18, 0.35);
}

.user-dot {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 248, 236, 0.92);
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(30, 20, 18, 0.18);
}

.user-dot-hover {
  opacity: 0.86;
}

/* ---------------- 2. Hero ---------------- */

.hero {
  position: relative;
  height: 55vh;
  min-height: 560rpx;
  max-height: 760rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: 96rpx;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  overflow: hidden;
  background-color: var(--bg);
}

/* 纸纹：远看是纸，近看有细颗粒 */
.hero::after {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  background-image:
    repeating-linear-gradient(
      0deg,
      rgba(97, 74, 68, 0.035) 0,
      rgba(97, 74, 68, 0.035) 1rpx,
      rgba(0, 0, 0, 0) 1rpx,
      rgba(0, 0, 0, 0) 4rpx
    ),
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.04) 0,
      rgba(255, 255, 255, 0.04) 1rpx,
      rgba(0, 0, 0, 0) 1rpx,
      rgba(0, 0, 0, 0) 6rpx
    );
}

.hero-dawn {
  background:
    radial-gradient(
      90% 60% at 20% 0%,
      rgba(255, 255, 255, 0.75) 0%,
      rgba(255, 255, 255, 0) 55%
    ),
    radial-gradient(
      70% 45% at 82% 12%,
      rgba(238, 205, 208, 0.55) 0%,
      rgba(238, 205, 208, 0) 70%
    ),
    linear-gradient(180deg, #f7e3e0 0%, #f9edd7 70%, #f9edd7 100%);
}

.hero-day {
  background:
    radial-gradient(
      80% 55% at 72% 6%,
      rgba(244, 195, 156, 0.45) 0%,
      rgba(244, 195, 156, 0) 68%
    ),
    radial-gradient(
      70% 45% at 18% 2%,
      rgba(255, 255, 255, 0.7) 0%,
      rgba(255, 255, 255, 0) 60%
    ),
    linear-gradient(180deg, #faeedc 0%, #f9edd7 64%, #f9edd7 100%);
}

.hero-dusk {
  background:
    radial-gradient(
      85% 55% at 50% 0%,
      rgba(250, 187, 149, 0.5) 0%,
      rgba(250, 187, 149, 0) 66%
    ),
    linear-gradient(180deg, #f3d2c2 0%, #f9edd7 72%, #f9edd7 100%);
}

.hero-night {
  background:
    radial-gradient(
      90% 60% at 50% 18%,
      rgba(67, 70, 105, 0.9) 0%,
      rgba(67, 70, 105, 0) 70%
    ),
    linear-gradient(180deg, #262a40 0%, #3a3e5d 42%, #252842 82%, #4a3a34 100%);
}

.hero-body {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 620rpx;
  color: var(--ink);
}

.hero-night .hero-body {
  color: #fff8ec;
}

.hero-greet {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.hero-night .hero-greet {
  text-shadow: 0 4rpx 20rpx rgba(30, 20, 18, 0.35);
}

.hero-date {
  margin-top: 14rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--ink2);
}

.hero-night .hero-date {
  color: rgba(255, 248, 236, 0.82);
}

.hero-copy {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink2);
}

.hero-night .hero-copy {
  color: rgba(255, 248, 236, 0.9);
}

/* ---------------- 卡片面板 ---------------- */

.panel {
  position: relative;
  z-index: 5;
  margin-top: -48rpx;
  padding: 48rpx 32rpx 0;
  background: var(--bg);
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.c-card-first {
  margin-top: 0;
}

.c-card {
  position: relative;
  margin-top: 24rpx;
  padding: 32rpx;
  background: var(--surface);
  border-radius: 48rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.card-hover {
  opacity: 0.9;
}

.c-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.c-dot {
  width: 8rpx;
  height: 28rpx;
  margin-right: 14rpx;
  flex: none;
  border-radius: 8rpx;
  background: var(--accent);
}

.c-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.c-note {
  max-width: 320rpx;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  color: var(--ink2);
}

.c-arrow {
  margin-left: auto;
  padding-left: 12rpx;
  font-size: 36rpx;
  line-height: 1;
  color: var(--ink-soft);
}


/* ---------------- 通用卡片文案 ---------------- */

.card-main {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--ink);
}

.card-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink2);
}

.card-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

/* ---------------- 4. 心情 ---------------- */

.mood-body {
  display: flex;
  align-items: center;
}

.mood-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 16rpx;
  flex: none;
  border-radius: 50%;
}

.mood-label {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.mood-time {
  margin-left: auto;
  padding-left: 16rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
}

.mood-note {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink2);
  word-break: break-all;
}

/* ---------------- 5. 听隅 ---------------- */

.sound-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.sound-row + .sound-row {
  border-top: 2rpx solid var(--line);
}

.sound-index {
  width: 48rpx;
  flex: none;
  font-size: 22rpx;
  color: var(--ink-soft);
  font-variant-numeric: tabular-nums;
}

.sound-name {
  font-size: 28rpx;
  color: var(--ink);
}

.sound-tag {
  margin-left: auto;
  padding-left: 16rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
}

/* ---------------- 6. 食谱日记 ---------------- */

.cook-body {
  display: flex;
  align-items: center;
}

.cook-tile {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface2);
  font-size: 34rpx;
  font-weight: 600;
  color: #8a6f5e;
}

.cook-text {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.cook-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.cook-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
}

/* ---------------- 7. 每日一言 ---------------- */

.quote-card {
  padding: 48rpx 40rpx 44rpx;
  text-align: center;
}

.quote-label {
  display: block;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: var(--ink-soft);
}

.quote-text {
  display: block;
  margin-top: 22rpx;
  font-size: 34rpx;
  line-height: 1.8;
  color: var(--ink);
  word-break: break-word;
}

.quote-from {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--ink-soft);
}

/* ---------------- 8. 页脚 ---------------- */

.footer {
  padding: 48rpx 0 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.footer-brand {
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: var(--ink-soft);
}

.footer-links {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ink-soft);
}

.footer-link {
  padding: 8rpx 4rpx;
  color: var(--accent-ink);
}

.footer-sep {
  margin: 0 10rpx;
  color: #b7a69e;
}