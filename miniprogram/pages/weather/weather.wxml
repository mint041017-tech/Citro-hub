<view class="page">
  <!-- 城市搜索 -->
  <view class="card search-card">
    <view class="search-row">
      <text class="search-ico">🔍</text>
      <input
        class="search-input"
        type="text"
        value="{{searchQ}}"
        placeholder="搜索城市，如 杭州、Tokyo"
        placeholder-class="search-ph"
        confirm-type="search"
        maxlength="40"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <view class="search-btn" hover-class="pressed" bindtap="onSearch">{{searchBtnText}}</view>
    </view>
    <view class="hint" wx:if="{{searchHint}}">{{searchHint}}</view>
    <view class="results" wx:if="{{showResults}}">
      <view
        class="result"
        wx:for="{{results}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="onPickCity"
        hover-class="result-hover"
      >
        <view class="result-main">{{item.name}}</view>
        <view class="result-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
      </view>
      <view class="result-empty" wx:if="{{resultsEmpty}}">没有找到匹配的城市</view>
    </view>
  </view>

  <!-- 无城市：搜索引导 -->
  <view class="card guide" wx:if="{{showGuide}}">
    <view class="guide-emoji">🌤️</view>
    <view class="guide-title">先选一个城市</view>
    <view class="guide-text">搜索并选择城市后，这里会显示实时天气、未来 24 小时和 7 天预报。</view>
  </view>

  <!-- 首次加载 -->
  <view class="card state" wx:if="{{showLoading}}">
    <view class="state-emoji">⏳</view>
    <view class="state-text">正在获取天气…</view>
  </view>

  <!-- 请求失败 -->
  <view class="card state" wx:if="{{error}}">
    <view class="state-emoji">🌧️</view>
    <view class="state-title">天气服务暂不可用</view>
    <view class="state-text">请检查网络后重试</view>
    <view class="retry-btn" hover-class="pressed" bindtap="onRetry">重试</view>
  </view>

  <!-- 当前天气 -->
  <view class="card now" wx:if="{{current}}">
    <view class="now-top">
      <view class="now-city-wrap">
        <view class="now-city">{{cityLabel}}</view>
        <view class="now-date">{{dateLine}}</view>
      </view>
      <view class="refresh" hover-class="pressed" bindtap="onRefresh">{{refreshText}}</view>
    </view>
    <view class="now-main">
      <view class="now-emoji">{{current.emoji}}</view>
      <view class="now-temp">{{current.tempText}}</view>
    </view>
    <view class="now-desc">{{current.desc}}</view>
    <view class="now-divider"></view>
    <view class="now-meta">
      <view class="meta-item">
        <view class="meta-label">体感</view>
        <view class="meta-value">{{current.feelsText}}</view>
      </view>
      <view class="meta-item">
        <view class="meta-label">湿度</view>
        <view class="meta-value">{{current.humidityText}}</view>
      </view>
      <view class="meta-item">
        <view class="meta-label">风速</view>
        <view class="meta-value">{{current.windText}}</view>
      </view>
    </view>
    <view class="now-updated">{{current.updatedText}}</view>
  </view>

  <!-- 未来 24 小时 -->
  <view class="card section" wx:if="{{hasHourly}}">
    <view class="section-head">
      <view class="section-bar"></view>
      <view class="section-title">未来 24 小时</view>
    </view>
    <scroll-view class="hours-scroll" scroll-x="true">
      <view class="hours">
        <view class="hour" wx:for="{{hourly}}" wx:key="key">
          <view class="hour-time">{{item.time}}</view>
          <view class="hour-emoji">{{item.emoji}}</view>
          <view class="hour-temp">{{item.tempText}}</view>
          <view class="hour-pop">{{item.popText}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 未来 7 天 -->
  <view class="card section" wx:if="{{hasDaily}}">
    <view class="section-head">
      <view class="section-bar"></view>
      <view class="section-title">未来 7 天</view>
    </view>
    <view class="days">
      <view class="day" wx:for="{{daily}}" wx:key="key">
        <view class="day-name">{{item.day}}</view>
        <view class="day-emoji">{{item.emoji}}</view>
        <view class="day-desc">{{item.desc}}</view>
        <view class="day-pop">{{item.popText}}</view>
        <view class="day-temp">{{item.highText}}<text class="day-low"> / {{item.lowText}}</text></view>
      </view>
    </view>
  </view>

  <!-- 日出日落 -->
  <view class="card sun" wx:if="{{showSun}}">
    <view class="sun-item">
      <view class="sun-label">日出</view>
      <view class="sun-emoji">🌅</view>
      <view class="sun-time">{{sunrise}}</view>
    </view>
    <view class="sun-split"></view>
    <view class="sun-item">
      <view class="sun-label">日落</view>
      <view class="sun-emoji">🌇</view>
      <view class="sun-time">{{sunset}}</view>
    </view>
  </view>

  <view class="foot">天气数据来自 Open-Meteo，仅供参考</view>
</view>